{
  "_comment": "Machine-readable canonical registry. dispatch-fields.md가 설명용 canonical, 이 파일이 실행용 canonical. template/builder/test는 이 registry의 consumer.",
  "contract_version": "0.1",
  "enums": {
    "dispatch_status": ["queued", "ready", "running", "complete", "failed", "merged", "blocked", "abandoned"],
    "terminal_statuses": ["merged", "abandoned"]
  },
  "transitions": {
    "queued":    ["ready", "blocked", "abandoned"],
    "ready":     ["running", "blocked"],
    "running":   ["complete", "failed", "abandoned"],
    "blocked":   ["ready"],
    "failed":    ["running"],
    "complete":  ["merged", "abandoned"],
    "merged":    [],
    "abandoned": []
  },
  "fields": {
    "required": [
      "dispatch_version", "dispatch_id", "task_id", "packet_path",
      "branch", "worktree_path", "assigned_agent", "status",
      "locked_paths", "history", "created_at", "created_by", "updated_at"
    ],
    "optional": [
      "owner_model", "status_reason",
      "depends_on_dispatch_ids", "merge_target",
      "retry_count", "max_retries",
      "tmux_session_hint", "launch_command_hint",
      "error_log", "escalated", "escalation_reason"
    ],
    "reserved": [
      "session_id", "heartbeat_path", "log_path"
    ],
    "forbidden": [
      "goal", "why", "done_definition", "required_checks",
      "deliverables", "constraints", "non_goals", "context_files", "priority"
    ]
  },
  "history_entry": {
    "required": ["from", "to", "at", "by", "reason"],
    "first_entry_from_null": true
  }
}
