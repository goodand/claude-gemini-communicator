# Agent Skill Runtime — environment template
# Copy to .env and fill in actual values. Never commit .env.
# Usage: cp .env.example .env   (bootstrap_agent_runtime_mac.sh does this automatically)

# ── LLM API keys ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=__SET_ME__
ANTHROPIC_API_KEY=__SET_ME__
GEMINI_API_KEY=__SET_ME__

# ── Optional: rerank experiments only ─────────────────────────────────────────
COHERE_API_KEY=__SET_ME__

# ── Skills root (leave empty for auto-detection) ──────────────────────────────
# bootstrap_agent_runtime_mac.sh sets this at runtime.
# Do not set to an absolute /Users/... path.
SKILLS_ROOT=
