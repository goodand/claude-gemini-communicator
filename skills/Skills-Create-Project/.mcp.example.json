{
  "mcpServers": {
    "codex-subagent": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "codex-as-mcp@latest"
      ]
    },
    "_optional_docling": {
      "_comment": "Remove leading underscore to enable. Requires: uvx and docling-mcp package.",
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from=docling-mcp",
        "docling-mcp-server"
      ]
    }
  }
}
