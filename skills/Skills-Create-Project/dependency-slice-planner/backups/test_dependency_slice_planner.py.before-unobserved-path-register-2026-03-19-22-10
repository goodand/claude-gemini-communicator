class DependencySlicePlannerTest(unittest.TestCase):
    def test_help_runs(self) -> None:
        result = subprocess.run(
            [sys.executable, str(SCRIPT_PATH), "--help"],
            check=True,
            capture_output=True,
            text=True,
        )
        self.assertIn("emit-slice-manifest-contract", result.stdout)
        self.assertIn("validate-slice-manifest", result.stdout)
        self.assertIn("emit-handoff-packet-contract", result.stdout)
        self.assertIn("validate-handoff-packet", result.stdout)
        self.assertIn("emit-inventory-snapshot-contract", result.stdout)
        self.assertIn("validate-inventory-snapshot", result.stdout)
        self.assertIn("emit-slice-seed-candidates-contract", result.stdout)
        self.assertIn("validate-slice-seed-candidates", result.stdout)
        self.assertIn("emit-static-dependency-overlay-contract", result.stdout)
        self.assertIn("validate-static-dependency-overlay", result.stdout)
        self.assertIn("emit-runtime-overlay-contract", result.stdout)
        self.assertIn("validate-runtime-overlay", result.stdout)
        self.assertIn("emit-inventory-path-index-contract", result.stdout)
        self.assertIn("validate-inventory-path-index", result.stdout)
        self.assertIn("emit-seed-refinement-report-contract", result.stdout)
        self.assertIn("build-seed-refinement-report", result.stdout)
        self.assertIn("emit-stop-rule-evaluation-contract", result.stdout)
        self.assertIn("evaluate-stop-rules", result.stdout)
        self.assertIn("emit-final-slice-proposal-contract", result.stdout)
        self.assertIn("build-final-slice-proposal", result.stdout)

    def test_emit_slice_manifest_contract_stdout_json(self) -> None:
        result = subprocess.run(
            [sys.executable, str(SCRIPT_PATH), "emit-slice-manifest-contract"],
            check=True,
            capture_output=True,
            text=True,
        )
        payload = json.loads(result.stdout)
        self.assertEqual(payload["contract_family"], "slice_manifest_contract")
        self.assertEqual(payload["classification_enum"], ["write_safe", "analysis_only"])
        self.assertIn("slice_count", payload["required_top_level_fields"])

    def test_validate_slice_manifest_valid(self) -> None:
        with tempfile.TemporaryDirectory() as tmpdir:
            manifest = Path(tmpdir) / "slice_manifest.json"
            manifest.write_text(json.dumps(VALID_MANIFEST, ensure_ascii=False), encoding="utf-8")

            result = subprocess.run(
                [sys.executable, str(SCRIPT_PATH), "validate-slice-manifest", "--input-manifest", str(manifest)],
                check=True,
                capture_output=True,
                text=True,
            )
            payload = json.loads(result.stdout)
            self.assertEqual(payload["status"], "valid")
            self.assertEqual(payload["error_count"], 0)

    def test_validate_slice_manifest_invalid(self) -> None:
        with tempfile.TemporaryDirectory() as tmpdir:
            manifest = Path(tmpdir) / "slice_manifest.json"
            manifest.write_text(json.dumps(INVALID_MANIFEST, ensure_ascii=False), encoding="utf-8")

            result = subprocess.run(
                [sys.executable, str(SCRIPT_PATH), "validate-slice-manifest", "--input-manifest", str(manifest)],
                check=False,
                capture_output=True,
                text=True,
            )
            self.assertEqual(result.returncode, 1)
            payload = json.loads(result.stdout)
            self.assertEqual(payload["status"], "invalid")
            self.assertGreaterEqual(payload["error_count"], 1)

    def test_emit_and_validate_write_files(self) -> None:
        with tempfile.TemporaryDirectory() as tmpdir:
            manifest = Path(tmpdir) / "slice_manifest.json"
            contract_json = Path(tmpdir) / "contract.json"
            contract_md = Path(tmpdir) / "contract.md"
            validation_json = Path(tmpdir) / "validation.json"
            validation_md = Path(tmpdir) / "validation.md"
            manifest.write_text(json.dumps(VALID_MANIFEST, ensure_ascii=False), encoding="utf-8")

            subprocess.run(
                [
                    sys.executable,
                    str(SCRIPT_PATH),
                    "emit-slice-manifest-contract",
                    "--output-json",
                    str(contract_json),
                    "--output-md",
                    str(contract_md),
                ],
                check=True,
                capture_output=True,
                text=True,
            )
            subprocess.run(
                [
                    sys.executable,
                    str(SCRIPT_PATH),
                    "validate-slice-manifest",
                    "--input-manifest",
                    str(manifest),
                    "--output-json",
                    str(validation_json),
                    "--output-md",
                    str(validation_md),
                ],
                check=True,
                capture_output=True,
                text=True,
            )

            contract = json.loads(contract_json.read_text(encoding="utf-8"))
            validation = json.loads(validation_json.read_text(encoding="utf-8"))
            self.assertEqual(contract["contract_family"], "slice_manifest_contract")
            self.assertEqual(validation["status"], "valid")
            self.assertIn("slice_manifest contract", contract_md.read_text(encoding="utf-8"))
            self.assertIn("slice_manifest validation", validation_md.read_text(encoding="utf-8"))

    def test_emit_handoff_packet_contract_stdout_json(self) -> None:
        result = subprocess.run(
            [sys.executable, str(SCRIPT_PATH), "emit-handoff-packet-contract"],
            check=True,
            capture_output=True,
            text=True,
        )
        payload = json.loads(result.stdout)
        self.assertEqual(payload["contract_family"], "handoff_packet_contract")
        self.assertIn("allowed_paths", payload["required_fields"])
        self.assertIn("non_goals", payload["required_fields"])

    def test_validate_handoff_packet_valid(self) -> None:
        with tempfile.TemporaryDirectory() as tmpdir:
            packet = Path(tmpdir) / "handoff_packet.json"
            packet.write_text(json.dumps(VALID_HANDOFF_PACKET, ensure_ascii=False), encoding="utf-8")

            result = subprocess.run(
                [sys.executable, str(SCRIPT_PATH), "validate-handoff-packet", "--input-packet", str(packet)],
                check=True,
                capture_output=True,
                text=True,
            )
            payload = json.loads(result.stdout)
