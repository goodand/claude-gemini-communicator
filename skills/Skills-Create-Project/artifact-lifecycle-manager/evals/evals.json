{
  "skill_name": "artifact-lifecycle-manager",
  "measured_by": "lifecycle 규칙 작동 유무 (order, duplicate, stale candidate)",
  "test_file": "scripts/test_artifact_lifecycle_guard.py",
  "test_count": 12,
  "evals": [
    {
      "id": 0,
      "rule": "metadata order: knowledge_base → consistency → implementation 순서 검증",
      "prompt": "knowledge_base, consistency, implementation 파일의 생성 순서가 맞는지 검사해줘",
      "assertions": [
        "order_epoch 기준 knowledge_base < consistency < implementation",
        "minute-level timestamp 누락 시 error",
        "artifact 2개 미만이면 failed"
      ],
      "test_coverage": ["test_check_order_passes_for_timestamped_chain"],
      "files": ["scripts/artifact_lifecycle_guard.py"]
    },
    {
      "id": 1,
      "rule": "duplicate scan: 동일 내용 markdown 탐지",
      "prompt": "같은 내용의 markdown 파일이 있는지 검사해줘",
      "assertions": [
        "SHA-256 해시 기준 동일 내용 그룹화",
        "legacy/ 기본 제외, --include-legacy로 포함",
        "duplicate 있으면 failed"
      ],
      "test_coverage": ["test_scan_duplicates_finds_same_content_active_files"],
      "files": ["scripts/artifact_lifecycle_guard.py"]
    },
    {
      "id": 2,
      "rule": "audit: order + duplicate 통합 검사",
      "prompt": "order 위반과 duplicate를 한번에 검사해줘",
      "assertions": [
        "order + duplicate 결과 통합",
        "하나라도 failed면 전체 failed",
        "--include-stale로 stale candidate 포함 가능"
      ],
      "test_coverage": ["test_audit_fails_on_order_violation_and_missing_timestamp", "test_audit_include_stale"],
      "files": ["scripts/artifact_lifecycle_guard.py"]
    },
    {
      "id": 3,
      "rule": "stale candidate: target이 문서보다 최신이면 candidate_stale",
      "prompt": "reference가 코드 변경 뒤 stale candidate인지 탐지해줘",
      "assertions": [
        "target mtime > doc mtime → candidate_stale",
        "doc mtime > target mtime → fresh",
        "target 없으면 needs_mapping",
        "target path 깨졌으면 missing_target",
        "legacy/ 기본 제외"
      ],
      "test_coverage": [
        "test_target_newer_is_candidate_stale",
        "test_doc_newer_is_fresh",
        "test_no_targets_is_needs_mapping",
        "test_broken_path_is_missing_target",
        "test_legacy_excluded_by_default"
      ],
      "files": ["scripts/artifact_lifecycle_guard.py"]
    },
    {
      "id": 4,
      "rule": "semantic owner: 문서 경로 기반 handoff 분류",
      "prompt": "stale candidate의 semantic recheck 담당 skill을 분류해줘",
      "assertions": [
        "checklist-for* → rule_bearing → doc-code-sync-checker",
        "references/*fields*, *contract*, *rule*, *vertical-slice* → rule_bearing",
        "나머지 references / knowledge_bases → claim_heavy → claim-verifier"
      ],
      "test_coverage": ["test_semantic_owner_classification"],
      "files": ["scripts/artifact_lifecycle_guard.py"]
    },
    {
      "id": 5,
      "rule": "exit code: --fail-on-candidate 정책",
      "prompt": "candidate_stale가 있을 때 exit code 정책을 확인해줘",
      "assertions": [
        "기본: candidate_stale 있어도 exit 0 (1차 owner이므로)",
        "--fail-on-candidate: candidate_stale > 0이면 exit 1"
      ],
      "test_coverage": ["test_fail_on_candidate_exit_code"],
      "files": ["scripts/artifact_lifecycle_guard.py"]
    },
    {
      "id": 6,
      "rule": "scope filter: --scope로 스캔 범위 제한",
      "prompt": "references만 스캔하도록 범위를 제한해줘",
      "assertions": [
        "--scope references → references/ 디렉토리만 스캔",
        "knowledge_bases, checklists 제외"
      ],
      "test_coverage": ["test_scope_filter"],
      "files": ["scripts/artifact_lifecycle_guard.py"]
    }
  ]
}
